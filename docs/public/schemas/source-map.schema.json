{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentknowledge.dev/schemas/source-map.schema.json",
  "title": "Agent Knowledge Source Map",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claims"
  ],
  "properties": {
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "text",
          "status",
          "source"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "confirmed",
              "inferred",
              "disputed",
              "stale",
              "missing",
              "source-required"
            ]
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "anchor": {
                "type": "string"
              }
            }
          },
          "compiled_into": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "document": {
            "type": "string"
          },
          "section_id": {
            "type": "string"
          }
        }
      }
    },
    "document_sections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "document",
          "section_id",
          "title"
        ],
        "properties": {
          "document": {
            "type": "string"
          },
          "section_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "source_anchors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "compiled_into": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
